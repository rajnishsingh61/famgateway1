SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
SUPABASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# Server-only Brevo transactional email
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=verified-sender@yourdomain.com
BREVO_SENDER_NAME=Nano Pay

# Public production origin used in email links
APP_BASE_URL=https://your-project.vercel.app

# Optional secret for manually/external scheduled verifier calls.
# If set, POST /api/public/hooks/verify requires Authorization: Bearer <secret>.
VERIFIER_SECRET=change-me
